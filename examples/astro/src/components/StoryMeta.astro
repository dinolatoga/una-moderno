---
import type { EditorialStory } from '../content/contract';
import { formattedDate } from '../content/stories';
interface Props {
  story: EditorialStory;
  compact?: boolean;
}
const { story, compact = false } = Astro.props;
---

<p class="una-meta">
  {compact && <span>{story.category}</span>}
  {!compact && <span>By {story.author}</span>}
  <time datetime={story.published}>{formattedDate(story.published, compact)}</time>
  {!compact && <span>{story.category}</span>}
</p>
