---
import '@una-moderno/core/una.css';
import '@una-moderno/core/fonts.css';
import { lead } from '../content/stories';

interface Props {
  title: string;
  description: string;
  current?: 'journal' | 'article' | 'about';
}

const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const navigation = [
  { href: base, label: 'The journal', active: current === 'journal' },
  { href: `${base}#recent`, label: 'Recent stories', active: false },
  {
    href: `${base}${lead.slug}/`,
    label: 'The long read',
    active: Astro.url.pathname === `${base}${lead.slug}/`,
  },
  { href: `${base}about/`, label: 'About this edition', active: current === 'about' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} — Una Moderno</title>
  </head>
  <body class="una">
    <a class="una-skip-link" href="#main">
      Skip to {current === 'article' ? 'article' : 'content'}
    </a>
    <div class="una-shell">
      <div class="una-utility">
        <p>An independent web journal</p>
        <p>Fictional editorial specimen</p>
      </div>
      <header class="una-masthead">
        <a class="una-brand" href={base} aria-label="Una Moderno home">
          Una<span>Moderno</span>
        </a>
        <p>Ideas, observations, and other things worth keeping.</p>
      </header>
      <nav class="una-nav" aria-label="Main navigation">
        {navigation.map(({ href, label, active }) => (
          <a href={href} aria-current={active ? 'page' : undefined}>
            {label}
          </a>
        ))}
      </nav>
      <slot />
      <footer class="una-footer">
        <p>Una Moderno · A portable editorial layout system.</p>
        <p>Fictional stories and authors. Real, reusable HTML &amp; CSS.</p>
        <a href={`${base}about/`}>About &amp; credits</a>
      </footer>
    </div>
  </body>
</html>
