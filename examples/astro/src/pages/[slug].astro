---
import type { GetStaticPaths } from 'astro';
import type { EditorialStory } from '../content/contract';
import Journal from '../layouts/Journal.astro';
import StoryMeta from '../components/StoryMeta.astro';
import StoryImage from '../components/StoryImage.astro';
import Body from '../components/Body.astro';
import { stories, storyRoutes } from '../content/stories';

export const getStaticPaths = (() =>
  storyRoutes.map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }))) satisfies GetStaticPaths;

interface Props {
  story: EditorialStory;
}
const { story } = Astro.props;
const base = import.meta.env.BASE_URL;
const headings = story.body.filter((block) => block.type === 'heading');
const nextStory = stories.find(
  (candidate) => candidate.slug !== story.slug && candidate.slug !== stories[0].slug,
)!;
---

<Journal title={story.title} description={story.summary} current="article">
  <div class="una-layout">
    <main id="main" class="una-main" tabindex="-1">
      <article class="una-feature">
        <h1 class="una-title">{story.title}</h1>
        <p class="una-deck">{story.summary}</p>
        <StoryMeta story={story} />
        {headings.length > 0 && (
          <nav class="una-contents-inline" aria-label="Article sections">
            <details>
              <summary>In this article</summary>
              <ol class="una-link-list">
                {headings.map((heading) => (
                  <li>
                    <a href={`#${heading.id}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        )}
        <StoryImage
          image={story.image}
          caption="Original geometric artwork for this fictional edition."
        />
        <Body blocks={story.body} />
      </article>
    </main>
    <aside class="una-sidebar" aria-label="Article navigation">
      <section class="una-module una-module--blue">
        <h2>Take your time.</h2>
        <p>A small essay from a fictional journal. Find your place below.</p>
      </section>
      {headings.length > 0 && (
        <nav class="una-module una-contents-sidebar" aria-label="In this article">
          <h2>In this article</h2>
          <ol class="una-link-list">
            {headings.map((heading) => (
              <li>
                <a href={`#${heading.id}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      <section class="una-module">
        <h2>Keep reading</h2>
        <ul class="una-link-list">
          <li>
            <a href={`${base}${nextStory.slug}/`}>{nextStory.title}</a>
          </li>
          <li>
            <a href={base}>Back to the journal</a>
          </li>
        </ul>
      </section>
      <section class="una-module">
        <p class="una-note">
          All authors and stories in this specimen are fictional. The layout is real HTML and CSS,
          with no runtime JavaScript.
        </p>
      </section>
    </aside>
  </div>
</Journal>
